# PoweResta server-side credentials template.
# Copy to a local untracked file or GitHub Actions secrets — never commit real values.
# Live HTTP remains disabled unless POWERESTA_LIVE_NETWORK=1 (authorized environments only).

POWERESTA_LIVE_NETWORK=0
POWERESTA_TENANT=
POWERESTA_PUBLIC_API_USERNAME=
POWERESTA_PASSWORD=
POWERESTA_SITE_NAME=
POWERESTA_MENU_NAME=
